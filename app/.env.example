# Why: tells the app which network and programs to talk to, without code changes.
# How: copy to .env.local (gitignored) for local dev; set the same keys in Vercel for deploys.

# Solana RPC the browser uses (devnet for the demo). A Helius/Triton devnet URL avoids rate limits.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
# Program IDs (default: the IDs inside src/idl/*.json)
NEXT_PUBLIC_ORACLE_ID=DsdJCXmXKXiYPEcWY1u2FFiTNZvsKKwwnUjybpfniPT7
NEXT_PUBLIC_PERP_ID=3ybvQ2fhnTV3qmzTSG6d8i5JpNqVpxe9D8e56arPsHhD
# "Normal" index in lamports per slot, for the ×-vs-normal figure
NEXT_PUBLIC_INDEX_BASELINE=5554000
