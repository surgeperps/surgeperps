# Why: documents which settings the keeper and scripts need, without leaking real values.
# How: copy this file to keeper/.env (or the folder you run from) and fill it in.
#      .env is gitignored; this file is committed.

# Solana RPC endpoint (a mainnet RPC for the keeper; devnet for scripts)
RPC_URL=
# Path to the Solana keypair that signs oracle updates, e.g. ~/.config/solana/id.json
KEYPAIR_PATH=
# Keeper: where to publish the index (the cluster the programs are deployed on)
PUBLISH_RPC_URL=https://api.devnet.solana.com
# Keeper: how often to write to the oracle, in ms (the perp rejects values older than ~60 s)
PUBLISH_EVERY_MS=10000
# Keeper: set to 0 to only watch, without publishing
PUBLISH=1
