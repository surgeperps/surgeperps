# Mainnet RPC the keeper reads blocks from (Helius mainnet URL with your key)
RPC_URL=
# Where the oracle lives. Public devnet is free and fine for one tx every 10 s.
PUBLISH_RPC_URL=https://api.devnet.solana.com
# Signing key. Locally: a file path. On a server: paste the JSON byte array into KEYPAIR_JSON instead.
KEYPAIR_PATH=~/.config/solana/id.json
# KEYPAIR_JSON=[12,34,...]
# Credit budget (see src/index.ts). Free Helius plan: these give ~29k credits/day.
# BLOCKS_PER_LOOP=2
# LOOP_MS=9000
